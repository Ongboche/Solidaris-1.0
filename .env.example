# Copy to .env for local development.
# The publishable key is public by design; access is enforced by row-level security.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Feature flags (brief §16.4): T7 signals, T9 uptake, T10 learning are proposals pending review.
VITE_FLAG_SIGNALS=false
VITE_FLAG_UPTAKE=false
VITE_FLAG_LEARNING=false
VITE_FLAG_GOOGLE_SIGN_IN=false
VITE_FLAG_LEGACY_EXPORT=false
